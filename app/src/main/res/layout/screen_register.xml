<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF4EE"
    tools:context=".Screens.Register">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_principal"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollRegister"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="34dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="220dp"
                android:layout_height="155dp"
                android:src="@drawable/icon_principal"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="Logo Gemma" />

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Crear cuenta"
                android:textColor="#5A382B"
                android:textSize="38sp"
                android:textStyle="italic"
                android:fontFamily="serif"
                android:gravity="center"
                android:includeFontPadding="false" />

            <LinearLayout
                android:id="@+id/layoutDecoracion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="56dp"
                    android:layout_height="1dp"
                    android:background="#C19035" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="✦"
                    android:textColor="#C19035"
                    android:textSize="26sp"
                    android:includeFontPadding="false" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="1dp"
                    android:background="#C19035" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="20dp"
                android:text="Únete a Gemma y disfruta beneficios exclusivos,\nrecompensas y creaciones únicas."
                android:textColor="#6A4A3B"
                android:textSize="21sp"
                android:textStyle="italic"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:includeFontPadding="false" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="20dp"
                app:cardBackgroundColor="#F8F4F0"
                app:cardCornerRadius="26dp"
                app:cardElevation="8dp"
                app:strokeColor="#F3ECE6"
                app:strokeWidth="1dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="22dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#00FFFFFF"
                        app:boxStrokeColor="#D4BFB0"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/icon_perfil_input"
                        app:startIconTint="#B8872D"
                        app:startIconContentDescription="Nombre completo">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:gravity="start|center_vertical"
                            android:hint="Nombre completo"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="#5B3A2D"
                            android:textColorHint="#6C4B3E"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="4dp"
                            android:paddingEnd="8dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#00FFFFFF"
                        app:boxStrokeColor="#D4BFB0"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/icon_email_input"
                        app:startIconTint="#B8872D"
                        app:startIconContentDescription="Correo electrónico">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCorreo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:gravity="start|center_vertical"
                            android:hint="Correo electrónico"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="#5B3A2D"
                            android:textColorHint="#6C4B3E"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="4dp"
                            android:paddingEnd="8dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#00FFFFFF"
                        app:boxStrokeColor="#D4BFB0"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/icon_password_input"
                        app:startIconTint="#B8872D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#B8872D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:gravity="start|center_vertical"
                            android:hint="Contraseña"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#5B3A2D"
                            android:textColorHint="#6C4B3E"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutConfirmarContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:boxBackgroundMode="outline"
                        app:boxBackgroundColor="#00FFFFFF"
                        app:boxStrokeColor="#D4BFB0"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:hintEnabled="false"
                        app:startIconDrawable="@drawable/icon_password_input"
                        app:startIconTint="#B8872D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#B8872D">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtConfirmarContrasena"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="54dp"
                            android:gravity="start|center_vertical"
                            android:hint="Confirmar contraseña"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#5B3A2D"
                            android:textColorHint="#6C4B3E"
                            android:textSize="19sp"
                            android:fontFamily="sans-serif"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCrearCuenta"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:text="CREAR CUENTA"
                        android:textAllCaps="true"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:gravity="center"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        app:backgroundTint="#6A4332"
                        app:cornerRadius="40dp"
                        app:strokeWidth="0dp" />

                    <LinearLayout
                        android:id="@+id/layoutLoginInferior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/txtYaTienesCuenta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¿Ya tienes una cuenta?"
                            android:textColor="#5D3D2F"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/txtEntrar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="ENTRAR"
                            android:textColor="#C19035"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
