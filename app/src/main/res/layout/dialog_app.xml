<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_app"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="26dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="84dp"
        android:layout_height="84dp">

        <ImageView
            android:id="@+id/imgIconDialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <com.wolop.wallet.ui.dialogs.GifLoadingView
            android:id="@+id/gifIconoCarga"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Cargando"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtTituloDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#3A2214"
        android:textSize="31sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMensajeDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="#6E5E51"
        android:textSize="21sp" />

    <View
        android:id="@+id/dividerDialog"
        android:layout_width="56dp"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:background="#C0964E" />

    <LinearLayout
        android:id="@+id/botonesDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNegativeDialog"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:backgroundTint="#FBF7EF"
            app:strokeColor="#C9BBA9"
            app:strokeWidth="1.2dp"
            app:cornerRadius="26dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#3A2214"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/separadorBotones"
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPositiveDialog"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            app:backgroundTint="#3E2719"
            app:cornerRadius="26dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:text="Aceptar"
            android:textAllCaps="false"
            android:textColor="#FBF7EF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
