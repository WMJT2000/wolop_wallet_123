<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardBackgroundColor="#E0D6EB"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="#DCC7A4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLocalIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_store" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtLocalNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_tienda"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="Tienda 1"
                android:textColor="#C0964E"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ubicación"
            android:textColor="#3A2214"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLocalUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Calle principal y calle secundaria"
            android:textColor="#3A2214"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Telefono"
                    android:textColor="#3A2214"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtLocalTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="09 999 9999"
                    android:textColor="#3A2214"
                    android:textSize="17sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnLocalUbicacion"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_gold"
                android:contentDescription="Ver ubicación"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_stores_ubication" />

            <ImageView
                android:id="@+id/btnLocalWhatsapp"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_circle_gold"
                android:contentDescription="Abrir WhatsApp"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_whatsapp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
