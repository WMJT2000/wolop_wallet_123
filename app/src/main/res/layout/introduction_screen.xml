<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8E7E5"
    tools:context=".screens.Introduction">

    <!-- SLIDER DE IMAGENES -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerIntroduction"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- BOTON CIRCULAR DE AVANZAR -->
    <ImageButton
        android:id="@+id/btnSiguiente"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="37dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/icon_benefit1"
        android:src="@drawable/icon_intro_next"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:contentDescription="Siguiente"
        android:elevation="2dp"
        app:tint="#D0A04C"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- BOTON SALTAR -->
    <TextView
        android:id="@+id/btnSaltar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="38dp"
        android:text="SALTAR"
        android:textColor="#382317"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnSiguiente"
        app:layout_constraintBottom_toBottomOf="@id/btnSiguiente" />

    <!-- INDICADORES DEL SLIDER -->
    <LinearLayout
        android:id="@+id/layoutIndicadores"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnSiguiente"
        app:layout_constraintBottom_toBottomOf="@id/btnSiguiente" />

</androidx.constraintlayout.widget.ConstraintLayout>
