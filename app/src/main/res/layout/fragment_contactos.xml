<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_principal"
    android:orientation="vertical"
    tools:context=".screens.home.tabs.ContactosFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp">

        <ImageView
            android:id="@+id/btnAtrasContactos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTituloContactos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Contactos"
            android:textColor="#3B2418"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <TextView
                android:id="@+id/txtEncuentranos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="Encuéntranos"
                android:textColor="#3A2214"
                android:textSize="30sp"
                android:textStyle="italic" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <ImageView
                android:id="@+id/imgLogoContactos"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="GEMMA Alta Pasticceria Italiana"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_principal" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileInstagram"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#E0D6EB"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:rippleColor="#1A3B2418"
                    app:strokeColor="#DCC7A4"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="Instagram"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_instagram" />
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileTikTok"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#DAEAD6"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:rippleColor="#1A3B2418"
                    app:strokeColor="#DCC7A4"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="TikTok"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_tiktok" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileFacebook"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#DBE4EB"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:rippleColor="#1A3B2418"
                    app:strokeColor="#DCC7A4"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="Facebook"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_facebook" />
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="30dp"
                    android:layout_height="1dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileWhatsApp"
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#EBE6A3"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardUseCompatPadding="false"
                    app:rippleColor="#1A3B2418"
                    app:strokeColor="#DCC7A4"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:contentDescription="WhatsApp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_whatsapp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="3" />

            <TextView
                android:id="@+id/txtConoceProductos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:lineSpacingExtra="4dp"
                android:text="CONOCE NUESTROS\nPRODUCTOS"
                android:textAlignment="center"
                android:textColor="#3A2214"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />
        </LinearLayout>
</LinearLayout>
